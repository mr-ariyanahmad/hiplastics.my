# --- Server-only secrets (never exposed to the browser) ---
HIPLASTICS_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
HIPLASTICS_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_SANDBOX=false
APP_BASE_URL=https://hiplastics.my

# --- Order confirmation emails (Resend: https://resend.com) ---
# Sign up free, verify your sending domain, create an API key.
RESEND_API_KEY=
ORDER_EMAIL_FROM=Hiplastics Malaysia <orders@hiplastics.my>

# Where low-stock alert emails go (defaults to sales@hiplastics.com.my if unset)
ADMIN_ALERT_EMAIL=

# Secret checked against the Authorization header on the abandoned-cart
# reminder cron. Vercel Cron sends this automatically as a Bearer token
# once this is set in your Vercel project env vars — generate any random
# string and put the same value here and in Vercel.
CRON_SECRET=

# --- Public, browser-exposed (VITE_ prefix required) ---
# Used ONLY for customer login/signup (anon key, safe to expose).
# Same Supabase project as above, but the ANON key, not the service role key.
VITE_HIPLASTICS_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_HIPLASTICS_SUPABASE_ANON_KEY=your-anon-public-key

# --- Analytics (optional — leave blank to disable) ---
# Nothing loads until the visitor accepts the cookie banner.
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=

# --- Google Search Console (optional — leave blank to skip) ---
# HTML-tag verification: Search Console → Settings → Ownership verification
# → HTML tag → copy just the "content" value (not the whole <meta> tag).
GOOGLE_SITE_VERIFICATION=
